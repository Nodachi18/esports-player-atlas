{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name, which is also its workers.dev hostname:
  // <name>.<account subdomain>.workers.dev → www.esports-player-atlas.workers.dev
  // Wrangler deploys by name, so changing this creates a second Worker rather than
  // renaming the existing one. Rename in the dashboard first, then change it here.
  "name": "www",
  // Which Cloudflare account to deploy into. An identifier, not a secret — it is recorded
  // here so the question does not come up on every deploy.
  "account_id": "877776dfd5a7c2cc7304cb6456115313",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Files in public/ are served directly without invoking the Worker (free, not counted as requests).
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      // The name the code reads it as: src/worker.js uses env.DB, and the npm db:* scripts
      // pass DB to wrangler. Renaming this breaks both.
      "binding": "DB",
      "database_name": "esports-player-atlas",
      "database_id": "a5d65c76-5b23-49d1-bf45-49383957a680"
    }
  ],
  // Throttles failed admin logins. No KV, no D1, no Durable Object and nothing to
  // provision — namespace_id is just an integer, unique per account, that this Worker
  // picks. `period` accepts 10 or 60 and nothing else.
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Failed code exchanges on /api/auth/discord/callback. A second namespace rather
      // than a second user of LOGIN_LIMIT: one shared bucket per IP means that hammering
      // sign-in locks the administrator out of their own site. It also throttles for a
      // different reason — nothing in the OAuth flow is guessable, so this is about not
      // letting a caller spend our application's quota at discord.com. See the comment on
      // the exchange-failure branch in src/worker.js.
      "name": "AUTH_LIMIT",
      "namespace_id": "1002",
      // Ten rather than the admin login's five: this one is consulted before the token
      // exchange, so a successful sign-in spends budget too, and the caller that would
      // notice is an entire shared address signing in at once.
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true },
  // The public hostname: www.esports-player-atlas.workers.dev
  "workers_dev": true,
  // Preview URLs default to following workers_dev, which would publish a second, public
  // hostname per uploaded version. One environment only, so: off, explicitly.
  "preview_urls": false
  // Secrets (not stored here): ADMIN_KEY, APP_SECRET, DISCORD_CLIENT_ID,
  // DISCORD_CLIENT_SECRET, DISCORD_REDIRECT_URI — set with `npx wrangler secret put <NAME>`.
  // The Discord three are read only by the auth routes, never by secrets(), so a missing
  // one breaks sign-in and leaves the rest of the site serving.
}
